# AI Documentation Generator Environment Configuration
# Copy this file to .env and fill in your actual API keys

# =============================================================================
# LLM PROVIDER CONFIGURATION
# =============================================================================

# Option 1: Using Gemini for both Analyzer and Documenter
# =======================================================

# Analyzer LLM (Code Analysis) - Using Gemini
ANALYZER_LLM_MODEL=gemini-1.5-pro
ANALYZER_LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta
ANALYZER_LLM_API_KEY=your_gemini_api_key_here

# Documenter LLM (README Generation) - Using Gemini  
DOCUMENTER_LLM_MODEL=gemini-1.5-pro
DOCUMENTER_LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta
DOCUMENTER_LLM_API_KEY=your_gemini_api_key_here

# Option 2: Mixed Configuration (OpenAI for Analyzer, Gemini for Documenter)
# ===========================================================================

# Analyzer LLM (Code Analysis) - Using OpenAI/Claude
# ANALYZER_LLM_MODEL=claude-sonnet-4-20250514
# ANALYZER_LLM_BASE_URL=https://api.openai.com/v1
# ANALYZER_LLM_API_KEY=your_openai_api_key_here

# Documenter LLM (README Generation) - Using Gemini
# DOCUMENTER_LLM_MODEL=gemini-1.5-pro
# DOCUMENTER_LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta
# DOCUMENTER_LLM_API_KEY=your_gemini_api_key_here

# Option 3: Using OpenAI for both (Alternative)
# =============================================

# Analyzer LLM (Code Analysis) - Using OpenAI
# ANALYZER_LLM_MODEL=gpt-4o
# ANALYZER_LLM_BASE_URL=https://api.openai.com/v1
# ANALYZER_LLM_API_KEY=your_openai_api_key_here

# Documenter LLM (README Generation) - Using OpenAI
# DOCUMENTER_LLM_MODEL=gpt-4o
# DOCUMENTER_LLM_BASE_URL=https://api.openai.com/v1
# DOCUMENTER_LLM_API_KEY=your_openai_api_key_here

# =============================================================================
# PERFORMANCE CONFIGURATION
# =============================================================================

# Enable parallel tool calls for better performance
ANALYZER_PARALLEL_TOOL_CALLS=true
DOCUMENTER_PARALLEL_TOOL_CALLS=true

# =============================================================================
# OBSERVABILITY CONFIGURATION (Optional)
# =============================================================================

# Enable Langfuse for LLM observability and monitoring
ENABLE_LANGFUSE=false
LANGFUSE_PUBLIC_KEY=your_langfuse_public_key_here
LANGFUSE_SECRET_KEY=your_langfuse_secret_key_here

# =============================================================================
# GITLAB INTEGRATION (For Cronjob Feature)
# =============================================================================

# GitLab API configuration for automated analysis
GITLAB_API_URL=https://git.divar.cloud
GITLAB_USER_NAME=AI Analyzer
GITLAB_USER_USERNAME=agent_doc
GITLAB_USER_EMAIL=your_email@example.com
GITLAB_OAUTH_TOKEN=your_gitlab_oauth_token_here

# =============================================================================
# GENERAL CONFIGURATION
# =============================================================================

# Environment setting (development, staging, production)
ENVIRONMENT=development

# Application version
APP_VERSION=1.0.0

# =============================================================================
# GEMINI API KEY SETUP INSTRUCTIONS
# =============================================================================
# 1. Go to https://aistudio.google.com/
# 2. Sign in with your Google account
# 3. Click "Get API key" in the top right
# 4. Create a new API key or use existing one
# 5. Copy the API key and replace 'your_gemini_api_key_here' above
#
# Available Gemini Models:
# - gemini-1.5-pro (recommended for documentation)
# - gemini-1.5-flash (faster, good for analysis)
# - gemini-1.0-pro (legacy)
#
# =============================================================================
# OPENAI API KEY SETUP INSTRUCTIONS
# =============================================================================
# 1. Go to https://platform.openai.com/api-keys
# 2. Sign in to your OpenAI account
# 3. Click "Create new secret key"
# 4. Copy the API key and replace 'your_openai_api_key_here' above
#
# Available OpenAI Models:
# - gpt-4o (recommended)
# - gpt-4-turbo
# - gpt-3.5-turbo
#
# For Claude models (via OpenAI-compatible API):
# - claude-sonnet-4-20250514
# - claude-3-5-sonnet-20241022